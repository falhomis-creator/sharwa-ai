[importlinter]
root_package = app
include_external_packages = True

[importlinter:contract:no-direct-psycopg-outside-db-layer]
name = Only app.db may talk to psycopg directly
type = forbidden
source_modules =
    app.api
    app.security
    app.channels
    app.killswitch
    app.main
    app.cli
    app.workers
    app.obs
forbidden_modules =
    psycopg
allow_indirect_imports = True

[importlinter:contract:workers-no-http-layer]
name = app.workers must not depend on the HTTP API layer (app.api/app.main)
type = forbidden
source_modules =
    app.workers
forbidden_modules =
    app.api
    app.main
allow_indirect_imports = False

[importlinter:contract:api-no-workers]
name = app.api must not depend on app.workers
type = forbidden
source_modules =
    app.api
forbidden_modules =
    app.workers
allow_indirect_imports = False

[importlinter:contract:workers-no-httpx]
name = app.workers must not import httpx directly (outbound via app.channels only)
type = forbidden
source_modules =
    app.workers
forbidden_modules =
    httpx
allow_indirect_imports = True

[importlinter:contract:fit-is-pure]
name = app.fit is pure (no DB, network, model or HTTP layers)
type = forbidden
source_modules =
    app.fit
forbidden_modules =
    psycopg
    httpx
    app.db
    app.llm
    app.api
    app.workers
    app.channels
allow_indirect_imports = False

[importlinter:contract:tools-are-pure]
name = app.tools is pure (no DB, network, model, channel or worker layers)
type = forbidden
source_modules =
    app.tools
forbidden_modules =
    psycopg
    httpx
    redis
    app.db
    app.llm
    app.channels
    app.workers
allow_indirect_imports = False

[importlinter:contract:verify-rules-stays-lexical]
name = verify_rules never imports app.fit or app.tools (the advice arrives as data)
type = forbidden
source_modules =
    app.workers.verify_rules
forbidden_modules =
    app.fit
    app.tools
allow_indirect_imports = False

[importlinter:contract:gift-is-pure]
name = app.gift is pure (no DB, network, model or HTTP layers)
type = forbidden
source_modules =
    app.gift
forbidden_modules =
    psycopg
    httpx
    redis
    app.db
    app.llm
    app.api
    app.workers
    app.channels
allow_indirect_imports = False
