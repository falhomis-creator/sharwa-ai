# Sharwa AI - environment variables (copy to `.env`, never commit the copy).
# Every value below is a placeholder. The real `.env` is gitignored.

# --- PostgreSQL (docker-compose.yml postgres) ---
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sharwa_ai

# --- Database roles (ops/postgres/init/10_roles.sh) ---
SHARWA_APP_USER=change-me
SHARWA_APP_PASSWORD=change-me
SHARWA_SYSTEM_USER=change-me
SHARWA_SYSTEM_PASSWORD=change-me
SHARWA_MIGRATION_USER=change-me
SHARWA_MIGRATION_PASSWORD=change-me

# --- Redis (docker-compose.yml) ---
REDIS_DURABLE_PASSWORD=change-me
REDIS_CACHE_PASSWORD=change-me

# --- Gateway app tier (docker-compose.yml gateway / gateway-forwarder, P0.2) ---
SHARWA_AI_GATEWAY_API_KEY=change-me
SHARWA_AI_GATEWAY_WEBHOOK_SECRET=change-me
# MinIO - OPTIONAL. Unset/wrong values are fine for now: gateway still starts
# and handles text messages; media uploads degrade gracefully (object_key:
# null, fallback text) until MinIO is confirmed and these are set for real.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Optional - docker-compose.yml already defaults these for the common case
# (Django/MinIO running on this same VPS host, outside compose). Uncomment
# to override:
# DJANGO_BASE_URL=http://host.docker.internal:8000
# MINIO_ENDPOINT_URL=http://host.docker.internal:9000
# MINIO_BUCKET_NAME=sharwa-ai
# MINIO_USE_SSL=false

# P0.3 closure: real MinIO used ONLY by docker-compose.test.yml for the
# media E2E acceptance tests (prompts/P0_DEEPSEEK_PROMPT.md P0.3) - fully
# separate from the production MINIO_* vars above.
MINIO_TEST_ACCESS_KEY=
MINIO_TEST_SECRET_KEY=
MINIO_TEST_BUCKET_NAME=sharwa-ai-test

# --- Shared metrics secret (docker-compose.yml gateway / gateway-forwarder /
# api /metrics; ops/prometheus/secrets/metrics_token) ---
# Pre-existing gap closed here: this was already required by
# docker-compose.yml's gateway/gateway-forwarder services (both refuse to
# start without it - see docs/P0_FINDINGS.md F16) but was never actually
# listed in this file. Added now rather than left for `api` alone to
# rediscover.
METRICS_TOKEN=change-me

# --- Core P0.7 API (docker-compose.yml `api` service, core/) ---
# core/'s own schema (tenants/channel_accounts/kill_switches/api_idempotency/
# ...) lives in the SAME ${POSTGRES_DB} database via the SAME three roles
# above (SHARWA_APP_USER/SHARWA_SYSTEM_USER/SHARWA_MIGRATION_USER) - no new
# database roles or passwords are needed for `api` itself.
JWT_ISSUER=change-me
JWT_AUDIENCE=change-me
# One of JWKS_URL / JWT_PUBLIC_KEY_PEM is required - the api refuses to boot
# with neither set (see core/app/config.py's JwtConfig). JWKS_URL is the
# active default here; set JWT_PUBLIC_KEY_PEM instead (a PEM-encoded RSA
# public key, single line with \n for newlines) if you need the static-PEM
# fallback, and leave JWKS_URL empty in that case.
JWKS_URL=change-me
JWT_PUBLIC_KEY_PEM=
SSO_LOGIN_URL=change-me
# Optional - docker-compose.yml already defaults this to the internal Docker
# network hostname (the api container reaches gateway directly over the
# `app` network, not through gateway's host-published loopback port).
# Uncomment to override:
# GATEWAY_BASE_URL=http://gateway:4001

# --- Core P1.0 realtime worker (docker-compose.yml `worker-realtime`) ---
# INGEST_SHARDS is the single source of truth for the WAL shard count. It is
# read by gateway, gateway-forwarder, AND worker-realtime from this ONE value
# (docker-compose.yml: INGEST_SHARDS: ${INGEST_SHARDS:-4}). Changing it is NOT
# live-redistributable: you must stop all three services together, because
# shardFor(session_id) = djb2(session_id) % INGEST_SHARDS would otherwise pin
# existing sessions to a different shard and leave a shard with no consumer
# (OQ-P1-06). Leave the default 4 unless you are re-provisioning the whole tier.
INGEST_SHARDS=4
# Optional - the worker's /healthz + /metrics port (default 4003; 4001 gateway,
# 4002 forwarder, 8080 api).
# CORE_WORKER_METRICS_PORT=4003
# Optional - opt-out phrase lists are CSV-overridable without a code deploy
# (OQ-P1-05); the defaults are the P1.1.5 Arabic/English lists.
# CORE_OPTOUT_PHRASES_AR=إيقاف,ايقاف,توقف,الغاء الاشتراك,إلغاء الاشتراك,لا اريد,لا أريد,لا ترسل,اوقف الرسائل
# CORE_OPTOUT_PHRASES_EN=stop,unsubscribe,opt out,optout

# --- Core P1.4 catalog (webhook + reconcile) ---
# Independent HMAC secret for POST /webhooks/platform/catalog (NOT the gateway
# secret). Empty value refuses boot (H5). The worker's outbound commerce calls
# use COMMERCE_BASE_URL (the sharwa_saas Commerce API base URL).
PLATFORM_WEBHOOK_SECRET=change-me
# PLATFORM_TIMESTAMP_SKEW_S=300
# PLATFORM_EVENT_BATCH_MAX=1000
# PLATFORM_WEBHOOK_BODY_MAX_BYTES=262144
# COMMERCE_BASE_URL=http://host.docker.internal:8000
# COMMERCE_TIMEOUT_S=3.0
# CATALOG_RECONCILE_INTERVAL_S=900
# CATALOG_RECONCILE_MAX_TENANTS=100
# CATALOG_RECONCILE_MAX_EVENTS_PER_TENANT=500

# --- Core P1.5 LLM layer (router + budget + breaker) ---
# LLM_PROVIDER defaults to "fake"; a fake provider is REFUSED when ENV=production
# (H-safety). No real provider/adapter exists yet this batch.
# LLM_PROVIDER=fake
# LLM_TIMEOUT_S=8.0
# LLM_BREAKER_FAIL_THRESHOLD=5
# LLM_BREAKER_RESET_S=60.0
# TENANT_MONTHLY_BUDGET_MICRO_USD=20000000
# LLM_PRICE_TABLE={"fake":{"fake-router":{"input":0,"output":0}}}
# LLM_ROUTER_HISTORY=6
# LLM_ROUTER_MAX_INPUT_CHARS=2000
# LLM_ROUTER_MIN_CONFIDENCE=0.6
# LLM_ROUTER_MAX_OUTPUT_TOKENS=64

# --- Core P1.5b embedding + vector search + rolling summary ---
# EMBEDDING_PROVIDER defaults to "fake"; a fake provider is REFUSED when
# ENV=production (H-safety, like LLM_PROVIDER). EMBEDDING_DIM must equal 1024
# (the catalog_embeddings.embedding vector width) - any other value refuses boot
# (H44). No real embedding provider exists yet this batch.
# EMBEDDING_PROVIDER=fake
# EMBEDDING_DIM=1024
# EMBED_INTERVAL_S=300
# EMBED_BATCH=32
# EMBED_MAX_PRODUCTS_PER_CYCLE=200
# EMBED_MAX_TEXT_CHARS=2000
# EMBED_TIMEOUT_S=8.0
# EMBED_QUERY_CACHE_TTL_S=3600
# SUMMARY_INTERVAL_S=120
# SUMMARY_MAX_PER_CYCLE=50
# SUMMARY_TRIGGER_MESSAGES=12
# SUMMARY_INPUT_MESSAGES=20
# SUMMARY_INPUT_MAX_CHARS=6000
# SUMMARY_MAX_OUTPUT_TOKENS=400
# SUMMARY_MAX_CHARS=1600
# SUMMARY_MIN_MESSAGES_BETWEEN=10
# SUMMARY_MAX_PER_CONVERSATION_PER_DAY=6

# --- Core P1.7 order tracking ---
# HMAC key for the order-reference fingerprint (workers/config.py ORDER_REF_HASH_KEY,
# _required, H54). Generate ONE long random value and keep it forever; changing it
# invalidates every already-seen fingerprint and resets the per-order rejection counter.
ORDER_REF_HASH_KEY=change-me

